# Copia este archivo a .env.local y completa los valores.
# NUNCA subas .env.local: el repositorio es público.

# ── App ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Marca visible (se puede cambiar sin tocar código) ──
NEXT_PUBLIC_BRAND_NAME=QR Menu
NEXT_PUBLIC_BRAND_TAGLINE=Tu menú del día, a un toque.

# ── Supabase (Project Settings → API Keys) ───────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_…) o anon key heredada
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_…) o service_role heredada. SOLO servidor.
SUPABASE_SERVICE_ROLE_KEY=

# ── Base de datos (Connect → ORMs / Connection string) ──
# Runtime: Transaction pooler (Supavisor, puerto 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migraciones: Session pooler (puerto 5432) o conexión directa
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Sentry (errores en producción) ───────────────────
# Sin DSN, Sentry queda desactivado y el SDK del navegador ni se descarga.
NEXT_PUBLIC_SENTRY_DSN=
# Solo en Vercel (build): para subir source maps. NUNCA en el repo.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
