# Copia este archivo a .env.local y completa los valores.
# NUNCA subas .env.local: el repositorio es público.

# ── App ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Marca visible (se puede cambiar sin tocar código) ──
NEXT_PUBLIC_BRAND_NAME=QR Menu
NEXT_PUBLIC_BRAND_TAGLINE=Tu menú del día, a un toque.

# ── Supabase (Project Settings → API Keys) ───────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_…) o anon key heredada
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_…) o service_role heredada. SOLO servidor.
SUPABASE_SERVICE_ROLE_KEY=

# ── Base de datos (Connect → ORMs / Connection string) ──
# Runtime: Transaction pooler (Supavisor, puerto 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migraciones: Session pooler (puerto 5432) o conexión directa
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Sentry (errores en producción) ───────────────────
# Sin DSN, Sentry queda desactivado y el SDK del navegador ni se descarga.
NEXT_PUBLIC_SENTRY_DSN=
# Solo en Vercel (build): para subir source maps. NUNCA en el repo.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Seed (solo desarrollo) ───────────────────────────
# Alcance: dev (default: base + demo + usuarios/PINs de prueba) | demo | base
SEED_SCOPE=
# Contraseña de los usuarios de prueba; si falta, el seed la genera y la agrega a .env.local
SEED_USERS_PASSWORD=
# Correos de los usuarios de prueba (por defecto admin@ / duenio@ / encargado@qrmenu.test)
SEED_ADMIN_EMAIL=
SEED_OWNER_EMAIL=
SEED_MANAGER_EMAIL=
# WhatsApp que recibe los pedidos del negocio demo (pon el tuyo para probar; por defecto un número inválido)
SEED_DEMO_WHATSAPP=
# PINs de staff de prueba (por defecto 1234 en Zona 1 y 5678 en Antigua)
SEED_STAFF_PIN_ZONA1=
SEED_STAFF_PIN_ANTIGUA=

# ── Ventas ───────────────────────────────────────────
# WhatsApp de ventas (para "mejorar mi plan" en las tarjetas de límite). E.164.
NEXT_PUBLIC_SALES_WHATSAPP=
